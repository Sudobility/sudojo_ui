{
  "name": "@sudobility/sudojo_ui",
  "version": "0.0.78",
  "description": "Shared Sudoku game UI components for Sudojo",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build:watch"
  },
  "peerDependencies": {
    "@heroicons/react": ">=2.0.0",
    "@sudobility/components": "^5.3.45",
    "@sudobility/design": "^1.1.66",
    "@sudobility/sudojo_lib": "^0.0.216",
    "@sudobility/sudojo_types": "^1.2.79",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@heroicons/react": "~2.2.0",
    "@sudobility/components": "^5.3.45",
    "@sudobility/design": "^1.1.66",
    "@sudobility/sudojo_lib": "^0.0.216",
    "@sudobility/sudojo_types": "^1.2.79",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "class-variance-authority": "~0.7.1",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "typescript": "~6.0.3"
  },
  "author": "Sudobility team",
  "license": "BUSL-1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/sudojo_ui.git"
  }
}
